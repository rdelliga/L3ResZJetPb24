# Setup environment
cmsenv
cd fillhistograms
root -l -b -q compile.C
# recompile every time you make changes to the code, shared libraries must be updated


# Running the Z+Jet Analysis (Muon Channel)

# Inside fillhistograms folder

# MC
root -l -b -q 'analyse_ZJet.cc("ZJETMC_0", "AK4_zjet", true, false, "era", -1, -1, "", -1, 1, "ak4PFJetAnalyzer/t", "muon")'
# Data
root -l -b -q 'analyse_ZJet.cc("ZJETDATA_0", "AK4_zjet", false, false, "era", -1, -1, "", -1, 1, "ak4PFJetAnalyzer/t", "muon")'


# Derive the 3D Responses, Fit the Residuals and Produce the .txt File

# Inside residualanalysis folder (cd ..)
root -l -b -q 'L3Residual/deriveL3.C("L3Residual/ZJETMC_0_AK4_zjet_ak4.root", "L3Residual/ZJETDATA_0_AK4_zjet_ak4.root", "L3Residual/L3_derived_zjet.root", "zjet", true, 5, false, true)'
root -l -b -q 'L3Residual/dofits_L3.C("L3Residual/L3_derived_zjet.root", 40, 300, "L3Res_zjet", false, "2024ppRef", "pp 480.4 pb^{-1}", true, false, "zjet")'


# Validation and plotting tool
root -l -b -q 'L3Residual/plotresponse_L3.C("L3Residual/ZJETDATA_0_AK4_zjet_ak4.root", "Data", false, "", "zjet")'
root -l -b -q 'L3Residual/plotresponse_L3.C("L3Residual/ZJETDATA_0_AK4_zjet_ak4.root", "Comparison", false, "L3Residual/ZJETMC_0_AK4_zjet_ak4.root", "zjet")'

# Git Setup for Residual Analysis

###0. CMSSW
cmsrel CMSSW_15_1_0_patch3
cd CMSSW_15_1_0_patch3

### 1. Clone from CERN GitLab (Source)
git clone ssh://git@gitlab.cern.ch:7999/bharikri/residualanalysis.git
cd residualanalysis
git fetch --all
git branch -a
git checkout remotes/origin/L3ResPhotonJet

### 2. Create/Switch to Working Branch
git checkout -b L3ResZJetPb24

### 3. Setup Private GitHub (Destination)
# Add GitHub as a new remote named "personal"
git remote add personal https://github.com/rdelliga/L3ResZJetPb24.git

# Switch remote to SSH (to fix auth issues)
git remote set-url personal git@github.com:rdelliga/L3ResZJetPb24.git

### 4. Push to GitHub
# First push (sets upstream link)
# Git has now permanently linked your local branch L3ResZJetPb24 to the one on your GitHub (personal) with -u option
git push -u personal L3ResZJetPb24

# Future pushes just
git push

### 5. Workflow: Pulling Upstream Updates to a New Clean Branch
# When the original GitLab repo is updated, follow these steps to start fresh:

# A. Save your current work on the old branch
# (Make sure to run 'git add' and 'git commit' or 'git stash' if you have modified files)

# B. Fetch the newest changes from the GitLab source (origin)
git fetch origin

# C. Create and switch to a new branch based directly on the updated GitLab branch
git checkout -b L3ResZJetPb24_v2 origin/L3ResPhotonJet

# D. Push the new clean branch to your personal GitHub and link it
git push -u personal L3ResZJetPb24_v2

# For future pushes on this new branch, just use:
git push
